<!--
  AI 新闻速报 · Deep Space 风格
  深空墨蓝，青蓝科技感，柔和光斑。
-->
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI 新闻速报 | {{period_label}}</title>
<style>
  :root{
    --bg-1:#0e1620;--bg-2:#121d2b;--card:#141f2e;
    --ink:#d8e2ee;--ink-soft:#8ea0b6;--ink-faint:#5e6f84;--line:#1e2c3d;
    --accent:#4cc4d8;--accent-soft:#2a7d8f;--warm:#e8a07a;--ok:#5fb88a;--gold:#d4b06a;
    --card-border:rgba(76,196,216,.12);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:"SF Pro Display","PingFang SC","Microsoft YaHei","Noto Sans SC",system-ui,sans-serif;color:var(--ink);line-height:1.8;background:linear-gradient(160deg,var(--bg-1) 0%,var(--bg-2) 55%,#0a1119 100%);background-attachment:fixed;-webkit-font-smoothing:antialiased}
  body::before{content:"";position:fixed;inset:0;z-index:0;pointer-events:none;background:radial-gradient(circle at 18% 22%,rgba(76,196,216,.08),transparent 40%),radial-gradient(circle at 82% 68%,rgba(111,212,230,.05),transparent 42%)}
  .wrap{position:relative;z-index:1;max-width:820px;margin:0 auto;padding:48px 28px 72px}
  header{text-align:center;padding:42px 28px 38px;background:var(--card);border:1px solid var(--card-border);border-radius:20px;box-shadow:0 8px 32px rgba(0,0,0,.35);margin-bottom:32px}
  header .badge{display:inline-block;font-size:12px;letter-spacing:2px;color:var(--accent);background:rgba(76,196,216,.10);padding:5px 16px;border-radius:999px;margin-bottom:16px}
  header h1{margin:0 0 12px;font-size:28px;font-weight:600;letter-spacing:1px}
  header .meta{color:var(--ink-soft);font-size:14px;display:flex;flex-wrap:wrap;justify-content:center;gap:4px 0}
  header .meta .sep{color:var(--ink-faint);margin:0 10px}
  .item{background:var(--card);border:1px solid var(--card-border);border-radius:16px;padding:26px 28px;margin-bottom:20px;box-shadow:0 6px 24px rgba(0,0,0,.30);transition:transform .3s ease,box-shadow .3s ease}
  .item:hover{transform:translateY(-2px);box-shadow:0 12px 36px rgba(0,0,0,.40)}
  .item-head{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin-bottom:8px}
  .item-num{color:var(--accent);font-weight:700;font-size:18px;font-family:"SF Mono",Menlo,Consolas,monospace}
  .item h3{margin:0;font-size:18px;font-weight:600;line-height:1.45;flex:1;min-width:60%}
  .tags{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0 14px}
  .tag{font-size:12px;padding:3px 12px;border-radius:999px;background:rgba(76,196,216,.08);color:var(--ink-soft)}
  .tag.confirmed{background:rgba(95,184,138,.14);color:var(--ok)}
  .tag.single-source{background:rgba(212,176,106,.14);color:var(--gold)}
  .tag.developing{background:rgba(76,196,216,.14);color:var(--accent)}
  .tag-score{background:rgba(76,196,216,.10);color:var(--accent)}
  .tag-time{background:rgba(232,160,122,.10);color:var(--warm)}
  .item p{margin:8px 0;color:var(--ink-soft);font-size:15px}
  .why{background:rgba(76,196,216,.05);border-left:3px solid var(--accent-soft);padding:12px 16px;border-radius:0 10px 10px 0;margin:14px 0;font-size:14.5px}
  .why b{color:var(--accent)}
  .link{margin-top:14px;font-size:14px;display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center}
  .link a{color:var(--warm);text-decoration:none;border-bottom:1px dashed rgba(232,160,122,.4);padding-bottom:1px;transition:opacity .2s}
  .link a:hover{opacity:.75}
  .link .label{color:var(--ink-faint);font-size:13px}
  .coverage{background:var(--card);border:1px solid var(--card-border);border-radius:16px;padding:24px 28px;margin-top:16px;box-shadow:0 6px 24px rgba(0,0,0,.30)}
  .coverage h2{margin:0 0 14px;font-size:18px;font-weight:600}
  .coverage ul{margin:0;padding-left:20px;color:var(--ink-soft);font-size:14.5px}
  .coverage li{margin:6px 0}
  .coverage b{color:var(--accent-soft)}
  footer{text-align:center;color:var(--ink-faint);font-size:13px;margin-top:40px;padding:0 20px;line-height:2}
  footer .accent{color:var(--accent);font-weight:500}
  @media(max-width:560px){.wrap{padding:28px 14px 48px}header{padding:30px 18px}header h1{font-size:22px}.item{padding:20px 16px}.item h3{font-size:16px}.tags{gap:6px}.link{flex-direction:column;gap:4px}}
  @media print{body{background:#fff;color:#1a1a1a;-webkit-print-color-adjust:exact;print-color-adjust:exact}body::before{display:none}.wrap{padding:20px 0}header{background:#f5f5f5;border:1px solid #ddd;box-shadow:none}header h1{color:#1a1a1a}.item{background:#fafafa;border:1px solid #ddd;box-shadow:none;break-inside:avoid;page-break-inside:avoid}.item h3{color:#1a1a1a}.why{background:#f0f8ff}.tag{border:1px solid #ccc;background:#f5f5f5;color:#333}.link a{color:#0066cc}.coverage{background:#f5f5f5;border:1px solid #ddd;box-shadow:none}a{color:#0066cc}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="badge">AI 新闻雷达</div>
    <h1>AI 新闻速报</h1>
    <div class="meta"><span>{{period_label}}</span><span class="sep">·</span><span>主题：{{topic}}</span><span class="sep">·</span><span>精选 {{item_count}} 条</span></div>
    <div class="meta" style="margin-top:8px;font-size:13px"><span>生成：{{report_date}}</span><span class="sep">·</span><span>时区：{{timezone}}</span></div>
  </header>
  {{#items}}
  <section class="item">
    <div class="item-head"><span class="item-num">{{index}}.</span><h3>{{title}}</h3></div>
    <div class="tags"><span class="tag tag-cat">{{category}}</span><span class="tag {{confidence}}">{{confidence_label}}</span><span class="tag tag-score">质量 {{quality_score}}/14</span><span class="tag tag-time">📅 {{published_at}}</span></div>
    <p>{{summary}}</p>
    <div class="why"><b>💡 为什么重要：</b>{{why_it_matters}}</div>
    <div class="link"><span class="label">🔗 一手来源：</span><a href="{{primary_url}}" target="_blank" rel="noopener">{{primary_url_host}}</a>{{#secondary_url}}<span class="label">·</span><a href="{{secondary_url}}" target="_blank" rel="noopener">独立报道</a>{{/secondary_url}}</div>
  </section>
  {{/items}}
  <section class="coverage">
    <h2>📋 覆盖说明</h2>
    <ul><li><b>检查信源组</b>：{{source_groups}}</li><li><b>覆盖缺口</b>：{{coverage_gaps}}</li><li><b>核验状态</b>：所有条目均打开原始页面核实，未将搜索摘要、社交帖或聚合器摘要作为证据。</li></ul>
  </section>
  <footer>由 <span class="accent">AI 新闻雷达</span> 自动整理 · 详情与原始论文 PDF 可查阅 Mneme 知识库对应的周期摘要页</footer>
</div>
</body>
</html>
