<!--
  AI 新闻速报 · Dopamine 风格
  高饱和粉紫青渐变，浅色基底，一眼醒目。
-->
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI 新闻速报 | {{period_label}}</title>
<style>
  :root{
    --bg:#fafafa;--card:#fff;--ink:#1a1a2e;--ink-soft:#555770;--ink-faint:#9a9ab0;--line:#e8e8f0;
    --pink:#ff2d78;--purple:#7c3aed;--cyan:#06b6d4;--green:#10b981;--amber:#f59e0b;
    --pink-soft:#fce7f3;--purple-soft:#ede9fe;--cyan-soft:#e0f7fa;--green-soft:#d1fae5;--amber-soft:#fef3c7;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:"SF Pro Display","PingFang SC","Microsoft YaHei","Noto Sans SC",system-ui,sans-serif;color:var(--ink);line-height:1.8;background:var(--bg);-webkit-font-smoothing:antialiased}
  .wrap{max-width:820px;margin:0 auto;padding:48px 28px 72px}
  header{text-align:center;padding:44px 28px 38px;background:linear-gradient(135deg,#ff2d78 0%,#7c3aed 50%,#06b6d4 100%);border-radius:20px;box-shadow:0 8px 32px rgba(124,58,237,.18);margin-bottom:32px;position:relative;overflow:hidden}
  header::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 20% 80%,rgba(255,255,255,.12),transparent 50%),radial-gradient(circle at 80% 20%,rgba(255,255,255,.08),transparent 45%);pointer-events:none}
  header .badge{position:relative;display:inline-block;font-size:12px;letter-spacing:2px;font-weight:600;color:#fff;background:rgba(255,255,255,.18);padding:5px 16px;border-radius:999px;margin-bottom:16px;backdrop-filter:blur(4px)}
  header h1{position:relative;margin:0 0 12px;font-size:30px;font-weight:700;letter-spacing:1px;color:#fff}
  header .meta{position:relative;color:rgba(255,255,255,.85);font-size:14px;display:flex;flex-wrap:wrap;justify-content:center;gap:4px 0}
  header .meta .sep{color:rgba(255,255,255,.4);margin:0 10px}
  .item{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:26px 28px;margin-bottom:20px;box-shadow:0 4px 16px rgba(0,0,0,.04);transition:transform .3s ease,box-shadow .3s ease}
  .item:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(124,58,237,.10)}
  .item-head{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin-bottom:8px}
  .item-num{color:var(--pink);font-weight:700;font-size:18px;font-family:"SF Mono",Menlo,Consolas,monospace}
  .item h3{margin:0;font-size:18px;font-weight:700;line-height:1.45;flex:1;min-width:60%}
  .tags{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0 14px}
  .tag{font-size:12px;font-weight:500;padding:3px 12px;border-radius:999px}
  .tag-cat{background:var(--purple-soft);color:var(--purple)}
  .tag.confirmed{background:var(--green-soft);color:var(--green)}
  .tag.single-source{background:var(--amber-soft);color:var(--amber)}
  .tag.developing{background:var(--cyan-soft);color:var(--cyan)}
  .tag-score{background:var(--cyan-soft);color:var(--cyan)}
  .tag-time{background:var(--pink-soft);color:var(--pink)}
  .item p{margin:8px 0;color:var(--ink-soft);font-size:15px}
  .why{background:linear-gradient(90deg,rgba(124,58,237,.06),rgba(6,182,212,.04));border-left:3px solid var(--purple);padding:12px 16px;border-radius:0 10px 10px 0;margin:14px 0;font-size:14.5px}
  .why b{color:var(--purple)}
  .link{margin-top:14px;font-size:14px;display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center}
  .link a{color:var(--pink);text-decoration:none;font-weight:500;border-bottom:1px dashed rgba(255,45,120,.3);padding-bottom:1px;transition:opacity .2s}
  .link a:hover{opacity:.7}
  .link .label{color:var(--ink-faint);font-size:13px}
  .coverage{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:24px 28px;margin-top:16px;box-shadow:0 4px 16px rgba(0,0,0,.04)}
  .coverage h2{margin:0 0 14px;font-size:18px;font-weight:700}
  .coverage ul{margin:0;padding-left:20px;color:var(--ink-soft);font-size:14.5px}
  .coverage li{margin:6px 0}
  .coverage b{color:var(--purple)}
  footer{text-align:center;color:var(--ink-faint);font-size:13px;margin-top:40px;padding:0 20px;line-height:2}
  footer .accent{color:var(--pink);font-weight:500}
  @media(max-width:560px){.wrap{padding:28px 14px 48px}header{padding:32px 18px}header h1{font-size:24px}.item{padding:20px 16px}.item h3{font-size:16px}.tags{gap:6px}.link{flex-direction:column;gap:4px}}
  @media print{body{background:#fff;-webkit-print-color-adjust:exact;print-color-adjust:exact}.wrap{padding:20px 0}header{background:#7c3aed!important;box-shadow:none}.item{box-shadow:none;break-inside:avoid;page-break-inside:avoid;border:1px solid #ddd}.tag{border:1px solid currentColor;background:transparent!important}.why{background:transparent!important}.coverage{box-shadow:none;border:1px solid #ddd}a{color:#7c3aed}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="badge">AI 新闻雷达</div>
    <h1>AI 新闻速报</h1>
    <div class="meta"><span>{{period_label}}</span><span class="sep">·</span><span>主题：{{topic}}</span><span class="sep">·</span><span>精选 {{item_count}} 条</span></div>
    <div class="meta" style="margin-top:8px;font-size:13px"><span>生成：{{report_date}}</span><span class="sep">·</span><span>时区：{{timezone}}</span></div>
  </header>
  {{#items}}
  <section class="item">
    <div class="item-head"><span class="item-num">{{index}}.</span><h3>{{title}}</h3></div>
    <div class="tags"><span class="tag tag-cat">{{category}}</span><span class="tag {{confidence}}">{{confidence_label}}</span><span class="tag tag-score">质量 {{quality_score}}/14</span><span class="tag tag-time">📅 {{published_at}}</span></div>
    <p>{{summary}}</p>
    <div class="why"><b>💡 为什么重要：</b>{{why_it_matters}}</div>
    <div class="link"><span class="label">🔗 一手来源：</span><a href="{{primary_url}}" target="_blank" rel="noopener">{{primary_url_host}}</a>{{#secondary_url}}<span class="label">·</span><a href="{{secondary_url}}" target="_blank" rel="noopener">独立报道</a>{{/secondary_url}}</div>
  </section>
  {{/items}}
  <section class="coverage">
    <h2>📋 覆盖说明</h2>
    <ul><li><b>检查信源组</b>：{{source_groups}}</li><li><b>覆盖缺口</b>：{{coverage_gaps}}</li><li><b>核验状态</b>：所有条目均打开原始页面核实，未将搜索摘要、社交帖或聚合器摘要作为证据。</li></ul>
  </section>
  <footer>由 <span class="accent">AI 新闻雷达</span> 自动整理 · 详情与原始论文 PDF 可查阅 Mneme 知识库对应的周期摘要页</footer>
</div>
</body>
</html>
